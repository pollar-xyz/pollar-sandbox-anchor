# Postgres (Neon project pollar-sandbox-anchor-testnet).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Public origin. Its host is the SEP-10 home_domain and web_auth_domain. Must be https outside localhost.
PUBLIC_URL=https://sandbox-anchor.pollar.xyz

# 32 random bytes, base64. Encrypts the anchor account secrets at rest: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Signs SEP-10 JWTs and interactive-flow tokens. At least 32 chars.
SEP10_JWT_SECRET=

# Admin login: signs the session cookie (at least 32 chars), Google OAuth client and allowed emails (comma separated).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=

# Stellar testnet.
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# Testnet USDC: Circle's issuer, funded through the Sozu faucet.
SOZU_FAUCET_URL=https://faucet.sozu.capital
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Horizon payments watcher. Run it in exactly one replica.
WATCHER_ENABLED=true
