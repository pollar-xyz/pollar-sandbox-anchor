{
  "name": "pollar-sandbox-anchor",
  "version": "0.1.0",
  "private": true,
  "description": "Public Stellar testnet anchor (SEP-1, SEP-10, SEP-24) that behaves like a real ARS/PEN/COP fiat anchor, for testing ramps end to end.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=24",
    "pnpm": "11.8.0"
  },
  "scripts": {
    "dev": "next dev -p 3090",
    "build": "prisma generate && next build",
    "start": "next start -p 3090",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "tsx scripts/anchor-cli.mts",
    "e2e": "tsx scripts/e2e-testnet.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "jose": "^6.0.0",
    "next": "16.2.9",
    "pg": "^8.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
